#!/usr/bin/env elixir
{#- Elixir app harness for server-pattern e2e tests

   This harness script is spawned as a subprocess by test_helper.exs and runs the
   SUT app, registering handlers per fixture. It loads all fixtures, creates
   handlers that return expected responses, and serves on a configured port.

   Context variables (passed from Elixir codegen):
   - app_class: class name for SUT app (e.g., "App")
   - register_route_method: app method to register routes (e.g., "route")
   - route_builder_class: class name for route builder (e.g., "MyPkg.RouteBuilder")
   - route_builder_schema_setter: method to set request schema (e.g., "request_schema_json")
   - method_enum_class: class name for method enum (e.g., "MyPkg.Method")
   - run_method: serve entrypoint (e.g., "run")
   - host: binding host (e.g., "127.0.0.1")
   - port: binding port (e.g., 8000)
   - binding_path: path to binding package
   - fixtures_json: raw JSON string with all fixtures (auto-serialized)
#}

# When run as a standalone script via elixir (not via mix), load dependencies
# from the calling process's ebin directories (passed via -pa flags).
# The dependencies are already compiled and accessible; this script just needs
# to ensure they're in the code path. The Application environment is not needed.

# Ensure the binding modules are loaded from code path
Code.ensure_loaded!({{ app_class }})
Code.ensure_loaded!({{ route_builder_class }})
Code.ensure_loaded!({{ method_enum_class }})
Code.ensure_loaded!({{ cors_config_class }})
{% if not skip_app_config -%}
Code.ensure_loaded!({{ server_config_class }})
{% endif %}

# Load fixtures from the JSON payload
fixtures_json = {{ fixtures_json }}
{:ok, fixtures} = Jason.decode(fixtures_json)

# Alias binding module names for readability
# The binding module name is derived from imports
alias {{ app_class }}
alias {{ route_builder_class }}
alias {{ method_enum_class }}
alias {{ cors_config_class }}
{% if not skip_app_config -%}
alias {{ server_config_class }}
{% endif %}

# Create and configure the app
app = {{ app_class }}.new()

# Register a handler for each fixture
app = Enum.reduce(fixtures, app, fn {fixture_id, fixture}, app_acc ->
  http = Map.get(fixture, "http")
  if is_nil(http) do
    app_acc
  else
    handler = Map.get(http, "handler", %{})
    method_str = Map.get(handler, "method", "GET") |> String.upcase()
    body_schema = Map.get(handler, "body_schema")
    expected = Map.get(http, "expected_response", %{})

    # Build handler function that returns the expected response
    expected_status = Map.get(expected, "status_code", 200)
    expected_body = Map.get(expected, "body")
    expected_headers = Map.get(expected, "headers") || %{}

    # Create handler closure that captures the expected values.
    # The response must be a map with the field names the NIF bridge decodes
    # into `spikard::Response` (status_code/content/headers) — a bare
    # `{status, body, headers}` tuple round-trips through Jason.encode! without
    # error (tuples just aren't a JSON type Jason emits meaningfully) and then
    # fails Rust-side deserialization with "missing field `status_code`".
    handler_fn = fn _request ->
      %{
        "status_code" => expected_status,
        "content" => expected_body,
        "headers" => expected_headers
      }
    end

    # Register the handler at /fixtures/<fixture_id>
    # Note: the test sends requests to /fixtures/{fixture_id};
    # the handler's route field is the intended target route the fixture simulates,
    # not the path to register on the SUT.
    full_route = "/fixtures/#{fixture_id}"

    # Build the RouteBuilder with the method and path
    method_atom = method_str |> String.downcase() |> String.to_atom()
    method_enum_val = apply({{ method_enum_class }}, method_atom, [])

    builder = {{ route_builder_class }}.new(method_enum_val, full_route)

    # If there's a body schema, attach it to the builder
    builder =
      if is_nil(body_schema) do
        builder
      else
        body_schema_json = Jason.encode!(body_schema)
        {{ route_builder_class }}.{{ route_builder_schema_setter }}(builder, body_schema_json)
      end

    # Thread handler middleware through to the RouteBuilder.
    # `middleware` is a {name => config} map; the dispatch table maps
    # middleware names to their builder function so new middlewares can be
    # added without changing this loop.
    middleware = Map.get(handler, "middleware") || %{}

    middleware_dispatch = %{
      "cors" => &{{ route_builder_class }}.cors/2
    }

    builder =
      Enum.reduce(middleware, builder, fn {mw_name, mw_config}, builder_acc ->
        cond do
          is_nil(mw_config) ->
            builder_acc

          Map.has_key?(middleware_dispatch, mw_name) ->
            builder_fn = Map.fetch!(middleware_dispatch, mw_name)

            case mw_name do
              "cors" ->
                cors_config =
                  struct({{ cors_config_class }}, %{
                    allowed_origins: Map.get(mw_config, "allowed_origins", []),
                    allowed_methods: Map.get(mw_config, "allowed_methods", []),
                    allowed_headers: Map.get(mw_config, "allowed_headers", []),
                    expose_headers: Map.get(mw_config, "expose_headers"),
                    max_age: Map.get(mw_config, "max_age"),
                    allow_credentials: Map.get(mw_config, "allow_credentials")
                  })

                # The NIF bridge (routebuilder_cors) takes the CORS config as a
                # JSON-encoded string, not the struct directly.
                builder_fn.(builder_acc, Jason.encode!(cors_config))

              _ ->
                builder_acc
            end

          true ->
            builder_acc
        end
      end)

    # Register the route with the handler
    app_acc = {{ app_class }}.{{ register_route_method }}(app_acc, builder, handler_fn)

    # If the fixture has CORS middleware configured, register an OPTIONS preflight handler.
    cors_middleware = Map.get(middleware, "cors")

    if is_nil(cors_middleware) do
      app_acc
    else
      # Case-insensitive header lookup helper (HTTP headers are case-insensitive).
      get_header_value = fn headers_map, name ->
        headers_map = headers_map || %{}

        case Map.get(headers_map, name) do
          nil ->
            lower_name = String.downcase(name)

            headers_map
            |> Enum.find(fn {key, _value} -> String.downcase(key) == lower_name end)
            |> case do
              {_key, value} -> value || ""
              nil -> ""
            end

          value ->
            value || ""
        end
      end

      cors_handler_fn = fn request ->
        # `request` is a `%Spikard.Conn{}` struct (atom keys), not a plain
        # string-keyed map, so headers are read via the `headers` field.
        headers_map = Map.get(request, :headers) || %{}
        origin = get_header_value.(headers_map, "origin")
        request_method = get_header_value.(headers_map, "access-control-request-method")
        request_headers = get_header_value.(headers_map, "access-control-request-headers")

        allowed_origins = Map.get(cors_middleware, "allowed_origins") || []
        allowed_methods = Map.get(cors_middleware, "allowed_methods") || []
        allowed_headers = Map.get(cors_middleware, "allowed_headers") || []

        is_origin_allowed = origin in allowed_origins

        is_method_allowed =
          request_method == "" or
            String.upcase(request_method) in Enum.map(allowed_methods, &String.upcase/1)

        headers_array =
          if request_headers == "" do
            []
          else
            request_headers |> String.split(",") |> Enum.map(&(&1 |> String.trim() |> String.upcase()))
          end

        allowed_headers_upcase = Enum.map(allowed_headers, &String.upcase/1)
        are_headers_allowed = Enum.all?(headers_array, fn h -> h in allowed_headers_upcase end)

        if not is_origin_allowed or not is_method_allowed or not are_headers_allowed do
          %{"status_code" => 403, "content" => nil, "headers" => %{}}
        else
          cors_headers = %{
            "Access-Control-Allow-Origin" => origin,
            "Access-Control-Allow-Methods" =>
              if(request_method == "", do: Enum.join(allowed_methods, ", "), else: request_method),
            "Access-Control-Allow-Headers" =>
              if(request_headers == "", do: Enum.join(allowed_headers, ", "), else: request_headers)
          }

          max_age = Map.get(cors_middleware, "max_age")

          cors_headers =
            if is_nil(max_age) do
              cors_headers
            else
              Map.put(cors_headers, "Access-Control-Max-Age", to_string(max_age))
            end

          %{"status_code" => 204, "content" => nil, "headers" => cors_headers}
        end
      end

      options_method = apply({{ method_enum_class }}, :options, [])
      options_builder = {{ route_builder_class }}.new(options_method, full_route)

      {{ app_class }}.{{ register_route_method }}(app_acc, options_builder, cors_handler_fn)
    end
  end
end)


# Resolve the port: SPIKARD_SERVER_PORT is set by the spawner when it
# allocates a free ephemeral port; fall back to the configured default.
effective_port =
  System.get_env("SPIKARD_SERVER_PORT", "{{ port }}") |> String.to_integer()

{% if not skip_app_config %}
# Configure and start the server
config = struct({{ server_config_class }}, %{
  host: "{{ host }}",
  port: effective_port
})

app = {{ app_class }}.config(app, config)
{%- endif %}

IO.puts("Harness listening on {{ host }}:#{effective_port}")

# Run the app
{{ app_class }}.{{ run_method }}(app)
