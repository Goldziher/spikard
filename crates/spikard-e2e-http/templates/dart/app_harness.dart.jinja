#!/usr/bin/env dart
/// App harness for server-pattern e2e tests.
///
/// This script spawns the SUT app and registers handlers per fixture,
/// returning expected responses. It's driven by the test setUpAll.

import 'dart:async';
import 'dart:convert';
import 'dart:io';
import 'package:{{ pkg_name }}/{{ pkg_name }}.dart';
import 'package:{{ pkg_name }}/src/{{ bridge_module }}/frb_generated.dart' show RustLib;

// Load fixtures from the JSON payload.
// The fixtures dict contains per-fixture data with handler route, method, body_schema, etc.
const String _FIXTURES_JSON = r'''{{ fixtures_json }}''';

Future<void> main() async {
  await RustLib.init();

  final fixtures = jsonDecode(_FIXTURES_JSON) as Map<String, dynamic>? ?? {};

  // Create and configure the app.
  final app = App();

  // Register a handler for each fixture.
  for (final MapEntry<String, dynamic> entry in fixtures.entries) {
    final fixtureId = entry.key;
    final fixture = entry.value as Map<String, dynamic>? ?? {};

    final http = fixture['http'] as Map<String, dynamic>?;
    if (http == null) continue;

    final handler = http['handler'] as Map<String, dynamic>? ?? {};
    final route = handler['route'] as String? ?? '/';
    final methodStr = (handler['method'] as String? ?? 'GET').toUpperCase();
    final bodySchema = handler['body_schema'] as String?;
    final expected = http['expected_response'] as Map<String, dynamic>? ?? {};

    final expectedStatus = expected['status_code'] as int? ?? 200;
    final expectedBody = expected['body'];
    final expectedHeaders = (expected['headers'] as Map<String, dynamic>? ?? {}).cast<String, String>();

    // request_timeout fixtures carry a sleep_ms directive: the handler must actually
    // sleep so the server's real timeout layer either fires (slow) or does not (fast).
    final middleware = handler['middleware'] as Map<String, dynamic>?;
    final requestTimeoutMw = middleware?['request_timeout'] as Map<String, dynamic>?;
    final sleepMs = (requestTimeoutMw?['sleep_ms'] as num?)?.toInt() ?? 0;

    // Build handler function that returns the expected response.
    Future<String> Function(String) makeHandler(int status, dynamic body, Map<String, String> headers) {
      return (String _requestJson) async {
        if (sleepMs > 0) {
          await Future<void>.delayed(Duration(milliseconds: sleepMs));
        }
        // Return the expected response as JSON with status_code, body, and headers.
        return jsonEncode({
          'status_code': status,
          'body': body,
          'headers': headers,
        });
      };
    }

    // Register the handler at /fixtures/<fixture_id>{route}
    final fullRoute = '/fixtures/$fixtureId$route';

    // Convert method string to Method enum.
    final methodEnum = _methodFromString(methodStr);
    if (methodEnum == null) continue;

    // Build the RouteBuilder with the path, method, and optional body schema.
    var builder = await RouteBuilder.newInstance(method: methodEnum, path: fullRoute);

    if (bodySchema != null && bodySchema.isNotEmpty) {
      builder = await builder.requestSchemaJson(bodySchema);
    }

    // Wire compression/body_limit/request_timeout/cors through to the RouteBuilder so
    // the real Rust-core middleware runs, instead of the handler unconditionally
    // returning the fixture's expected response regardless of middleware behavior.
    final compressionMw = middleware?['compression'] as Map<String, dynamic>?;
    if (compressionMw != null) {
      builder = await builder.compression(
        compression: CompressionConfig(
          gzip: compressionMw['gzip'] as bool? ?? false,
          brotli: compressionMw['brotli'] as bool? ?? false,
          minSize: (compressionMw['min_size'] as num?)?.toInt() ?? 0,
          quality: (compressionMw['quality'] as num?)?.toInt() ?? 0,
        ),
      );
    }

    final bodyLimitMw = middleware?['body_limit'] as Map<String, dynamic>?;
    final maxBytes = bodyLimitMw?['max_bytes'] as num?;
    if (maxBytes != null) {
      builder = await builder.bodyLimit(maxBytes: maxBytes.toInt());
    }

    final requestTimeoutSeconds = requestTimeoutMw?['seconds'] as num?;
    if (requestTimeoutSeconds != null) {
      builder = await builder.requestTimeout(seconds: requestTimeoutSeconds.toInt());
    }

    final corsMw = middleware?['cors'] as Map<String, dynamic>?;
    if (corsMw != null) {
      builder = await builder.cors(
        cors: CorsConfig(
          allowedOrigins: ((corsMw['allow_origins'] as List<dynamic>?) ?? const []).cast<String>(),
          allowedMethods: ((corsMw['allow_methods'] as List<dynamic>?) ?? const []).cast<String>(),
          allowedHeaders: ((corsMw['allow_headers'] as List<dynamic>?) ?? const []).cast<String>(),
          exposeHeaders: (corsMw['expose_headers'] as List<dynamic>?)?.cast<String>(),
          maxAge: (corsMw['max_age'] as num?)?.toInt(),
          allowCredentials: corsMw['allow_credentials'] as bool?,
        ),
      );
    }

    // Register the route with the handler.
    app.route(
      builder,
      makeHandler(expectedStatus, expectedBody, expectedHeaders),
    );
  }

  // Bind and start the server. SPIKARD_SERVER_PORT is set by the spawner
  // when it allocates a free ephemeral port (honored by the core server via
  // ServerConfig::default()); fall back to the configured default otherwise.
  const host = '{{ host }}';
  final port = int.tryParse(Platform.environment['SPIKARD_SERVER_PORT'] ?? '') ?? {{ port }};

  // Print the SUT_URL so the test harness knows we're listening.
  print('SUT_URL=http://$host:$port');

  // Run the app (blocks until shutdown).
  await app.run();
}

/// Convert HTTP method string (e.g., "GET", "POST") to Method enum.
Method? _methodFromString(String methodStr) {
  switch (methodStr) {
    case 'GET':
      return Method.get_;
    case 'POST':
      return Method.post;
    case 'PUT':
      return Method.put;
    case 'DELETE':
      return Method.delete;
    case 'PATCH':
      return Method.patch;
    case 'HEAD':
      return Method.head;
    case 'OPTIONS':
      return Method.options;
    case 'CONNECT':
      return Method.connect;
    case 'TRACE':
      return Method.trace;
    default:
      return null;
  }
}
