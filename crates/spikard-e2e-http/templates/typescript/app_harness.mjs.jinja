{{ header }}
/**
 * App harness for server-pattern e2e tests
 *
 * This harness is spawned as a subprocess and runs the SUT app,
 * registering handlers per fixture. It loads all fixtures, creates
 * handlers that return expected responses, and serves on a configured port.
 *
 * The e2e harness is low-level fixture infrastructure (generic dict handlers,
 * raw RouteBuilder), so it uses the low-level `.service` App primitive rather
 * than the ergonomic top-level `App` (which introspects typed handlers).
 */

{% if import_style == "named" %}
{% for import_name in imports -%}
import { {{ app_class }}, {{ method_enum }}, {{ route_builder_class }}, CorsConfig, CompressionConfig, ApiKeyAuthConfig, JwtAuthConfig, BearerAuthConfig } from '{{ import_name }}/service';
import { {{ server_config_factory_import }} } from '{{ import_name }}';
{% endfor -%}
{% else %}
{% for import_name in imports -%}
import _servicePkg from '{{ import_name }}/service';
import _pkg from '{{ import_name }}';
{% endfor -%}
const { {{ app_class }}, {{ method_enum }}, {{ route_builder_class }}, CorsConfig, CompressionConfig, ApiKeyAuthConfig, JwtAuthConfig, BearerAuthConfig } = _servicePkg;
const { {{ server_config_factory_import }} } = _pkg;
{% endif %}

// Load fixtures from the inline JSON payload.
const _FIXTURES = {{fixtures_json}};

// Create and configure the app
{% if constructor_method == ".new()" -%}
const app = {{ app_class }}.new();
{% else -%}
const app = new {{ app_class }}();
{% endif -%}

// Map HTTP method name to the corresponding Method enum value
const methodMap = {
  'GET': {{ method_enum }}.Get,
  'POST': {{ method_enum }}.Post,
  'PUT': {{ method_enum }}.Put,
  'PATCH': {{ method_enum }}.Patch,
  'DELETE': {{ method_enum }}.Delete,
  'HEAD': {{ method_enum }}.Head,
  'OPTIONS': {{ method_enum }}.Options,
  'CONNECT': {{ method_enum }}.Connect,
  'TRACE': {{ method_enum }}.Trace,
};

// Register a handler for each fixture
for (const [fixtureId, fixture] of Object.entries(_FIXTURES)) {
  const http = fixture.http;
  if (!http) continue;

  const handler = http.handler || {};
  const route = handler.route || '/';
  const methodStr = (handler.method || 'GET').toUpperCase();
  const expected = http.expected_response || {};

  const expectedStatus = expected.status_code || 200;
  const expectedBody = expected.body;
  const expectedHeaders = expected.headers || {};

  // Map method string to the Method enum value
  const methodEnum = methodMap[methodStr];
  if (!methodEnum) {
    console.warn(`Skipping fixture ${fixtureId}: unknown HTTP method ${methodStr}`);
    continue;
  }

  // Build handler function that returns the expected response.
  // content-encoding and transfer-encoding are stripped from the handler
  // response: the compression middleware produces them, and emitting e.g.
  // content-encoding on an uncompressed handler body makes the compression
  // layer skip compression, leaving a declared-but-not-applied encoding the
  // client cannot decode. vary and content-length are NOT stripped: some
  // fixtures (e.g. CORS safelisted-headers, HEAD) assert those headers
  // verbatim as declared by the fixture with no corresponding middleware
  // layer to (re)produce them, matching the reference Python harness, which
  // does not filter any header.
  const _middlewareManagedHeaders = new Set(['content-encoding', 'transfer-encoding']);
  const handlerHeaders = Object.fromEntries(
    Object.entries(expectedHeaders).filter(([name]) => !_middlewareManagedHeaders.has(name.toLowerCase()))
  );
  // request_timeout fixtures carry a `sleep_ms` directive: the handler must
  // actually sleep so the server timeout layer either fires (slow) or does not
  // (fast), matching the fixture expectation. Everything else resolves promptly.
  const _rtConfig = (handler.middleware && handler.middleware.request_timeout) || null;
  const _sleepMs = _rtConfig && typeof _rtConfig.sleep_ms === 'number' ? _rtConfig.sleep_ms : 0;
  const handlerFn = async (request) => {
    if (_sleepMs > 0) {
      await new Promise((resolve) => setTimeout(resolve, _sleepMs));
    }
    return {
      status_code: expectedStatus,
      {{ response_body_field }}: expectedBody,
      headers: { ...handlerHeaders }
    };
  };

  // Register the handler at /fixtures/<fixture_id>{route}
  const fullRoute = `/fixtures/${fixtureId}${route}`;

  // GraphQL fixtures register a real SDL-backed endpoint that executes the query
  // against the fixture schema, rather than the generic static-response handler.
  const _graphqlConfig = (handler.middleware && handler.middleware.graphql) || null;
  if (_graphqlConfig && _graphqlConfig.enabled && typeof app.registerGraphqlSdlRoute === 'function') {
    app.registerGraphqlSdlRoute(
      fullRoute,
      methodEnum,
      _graphqlConfig.schema,
      _graphqlConfig.response_data ?? {},
      undefined,
    );
    continue;
  }

  // Build RouteBuilder and register the route
  {% if route_builder_constructor_method == ".new" -%}
  let builder = {{ route_builder_class }}.new(methodEnum, fullRoute);
  {%- else -%}
  let builder = new {{ route_builder_class }}(methodEnum, fullRoute);
  {%- endif %}

  // If there's a body schema, attach it to the builder.
  const bodySchema = handler.body_schema;
  if (bodySchema !== null && bodySchema !== undefined && typeof builder.requestSchemaJson === 'function') {
    builder = builder.requestSchemaJson(bodySchema);
  }

  // Wire handler middleware through to the RouteBuilder.
  // Each entry in `middleware` is a {name: config} pair. The dispatch table
  // maps middleware names to their builder methods so new middlewares can be
  // added without changing this loop.
  if (handler.middleware) {
    const middlewareDispatch = {
      'cors': 'cors',
      'compression': 'compression',
      'api_key_auth': 'api_key_auth',
      'jwt_auth': 'jwt_auth',
      'bearer_auth': 'bearer_auth',
    };
    for (const [mwName, mwConfig] of Object.entries(handler.middleware)) {
      if (mwConfig === null || mwConfig === undefined) {
        continue;
      }
      // Route-limit middlewares take a scalar argument extracted from their
      // config object, not the whole object. graphql is handled above.
      if (mwName === 'body_limit') {
        if (typeof mwConfig.max_bytes === 'number' && typeof builder.bodyLimit === 'function') {
          builder = builder.bodyLimit(mwConfig.max_bytes);
        }
        continue;
      }
      if (mwName === 'request_timeout') {
        if (typeof mwConfig.seconds === 'number' && typeof builder.requestTimeout === 'function') {
          builder = builder.requestTimeout(mwConfig.seconds);
        }
        continue;
      }
      if (mwName === 'graphql') {
        continue;
      }
      const builderMethod = middlewareDispatch[mwName];
      if (builderMethod === undefined) {
        continue;
      }
      // The napi CorsConfig/CompressionConfig objects require camelCase field
      // names; the fixture middleware config carries the Rust core's
      // snake_case serde names. napi silently drops unrecognized keys rather
      // than erroring, so an un-mapped config becomes an empty object. `null`
      // is coerced to `undefined` for each field: napi's Option<T> conversion
      // accepts a missing property but rejects an explicit `null`.
      let napiConfig = mwConfig;
      if (mwName === 'cors') {
        napiConfig = {
          allowedOrigins: mwConfig.allow_origins ?? undefined,
          allowedMethods: mwConfig.allow_methods ?? undefined,
          allowedHeaders: mwConfig.allow_headers ?? undefined,
          exposeHeaders: mwConfig.expose_headers ?? undefined,
          maxAge: mwConfig.max_age ?? undefined,
          allowCredentials: mwConfig.allow_credentials ?? undefined,
        };
      } else if (mwName === 'compression') {
        napiConfig = {
          gzip: mwConfig.gzip ?? undefined,
          brotli: mwConfig.brotli ?? undefined,
          minSize: mwConfig.min_size ?? undefined,
          quality: mwConfig.quality ?? undefined,
        };
      }
      if (typeof builder[builderMethod] === 'function') {
        builder = builder[builderMethod](napiConfig);
      }
    }
  }

  app.{{ register_route_method }}(builder, handlerFn);

  // No manual OPTIONS preflight handler is registered here. The Rust core
  // (crates/spikard-http/src/cors.rs::handle_preflight) already answers CORS
  // preflight requests for any route with a correctly-wired CorsConfig (see
  // the napi field-name mapping above). A hand-rolled JS OPTIONS handler
  // registered at the same route was a workaround from when the config was
  // silently dropped by a napi field-name mismatch; with that fixed, the
  // duplicate registration only shadows the real preflight response with an
  // incomplete one (it observed a null request object) — so it is removed.
}

// Configure and start the server.
// SPIKARD_SERVER_PORT is set by the spawner when it allocates a free
// ephemeral port; fall back to the configured default port otherwise.
const _port = process.env.SPIKARD_SERVER_PORT ? Number(process.env.SPIKARD_SERVER_PORT) : {{ port }};
const config = {{ server_config_factory }};
config.host = '{{ host }}';
config.port = _port;
app.config(config);

console.log(`Harness listening on {{ host }}:${_port}`);
await app.{{ run_method }}();
