{#- Swift app harness for server-pattern e2e tests

   This harness executable is spawned as a subprocess by the test suite's
   setUp() and runs the SUT app, registering handlers per fixture. It loads
   all fixtures, creates handlers that return expected responses, and serves
   on a configured port.

   Context variables (passed from Swift codegen):
   - fixtures_json: raw JSON string with all fixtures (auto-serialized)
   - host: binding host (e.g., "127.0.0.1")
   - port: binding port (e.g., 8009)
#}
// swift-format-ignore-file
import Foundation
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif

{{ imports }}

// Load fixtures from the JSON payload.
// The fixtures dict contains per-fixture data with handler route, method, body_schema, etc.
// Split JSON across multiple raw string literals (safe delimiters computed in Rust).
let _FIXTURES_JSON: String = [
{%- for chunk in fixtures_json_chunks %}
    {{ chunk }},
{%- endfor %}
].joined()

guard let _fixturesData = _FIXTURES_JSON.data(using: .utf8),
      let _fixtures = try? JSONSerialization.jsonObject(with: _fixturesData) as? [String: [String: Any]] else {
    print("Failed to parse fixtures JSON")
    exit(1)
}

// Create the app.
let app = {{ app_class }}()

// Register a handler for each fixture using convenience methods.
for (fixtureId, fixtureDict) in _fixtures {
    guard let http = fixtureDict["http"] as? [String: Any] else {
        continue
    }

    guard let handler = http["handler"] as? [String: Any] else {
        continue
    }

    let route = handler["route"] as? String ?? "/"
    let methodStr = (handler["method"] as? String ?? "GET").lowercased()
    let expected = http["expected_response"] as? [String: Any] ?? [:]
    let middleware = handler["middleware"] as? [String: Any]
    let corsConfigDict = middleware?["cors"] as? [String: Any]
    let compressionConfigDict = middleware?["compression"] as? [String: Any]

    // Decode the fixture's cors/compression config (if any) into the real Spikard types and
    // hand them to the route registration call below so the Rust core's actual CORS/compression
    // middleware runs — mirrors `route_builder.cors(...)`/`.compression(...)` in the other
    // bindings. This replaces harness-side preflight/compression emulation entirely. ~keep
    var corsConfig: CorsConfig?
    if let corsConfigDict = corsConfigDict,
       let corsData = try? JSONSerialization.data(withJSONObject: corsConfigDict, options: []) {
        corsConfig = try? JSONDecoder().decode(CorsConfig.self, from: corsData)
    }
    var compressionConfig: CompressionConfig?
    if let compressionConfigDict = compressionConfigDict,
       let compressionData = try? JSONSerialization.data(withJSONObject: compressionConfigDict, options: []) {
        compressionConfig = try? JSONDecoder().decode(CompressionConfig.self, from: compressionData)
    }

    // Extract expected response values.
    let expectedStatus = expected["status_code"] as? Int ?? 200
    // Pre-formatted JSON text for the body (see swift.rs::render_app_harness), spliced verbatim
    // into the response envelope below instead of going through `JSONSerialization`, which
    // collapses whole-number `Double`s (e.g. `5.0`) to integers on decode. ~keep
    let expectedBodyJSON = expected["body_json"] as? String ?? "null"
    var expectedHeaders = expected["headers"] as? [String: String] ?? [:]
    // Fixtures declare the body/headers the *decompressed* response should have;
    // the harness itself never compresses the body. A fixture-declared
    // Content-Encoding must always be dropped here: URLSession transparently
    // decodes any response that claims one, and hangs/fails the request outright
    // when handed a body that (truthfully) isn't actually encoded that way. This
    // applies to any fixture (not just ones with explicit compression middleware —
    // e.g. server_config's "compression enabled globally" fixture has none).
    for key in expectedHeaders.keys where key.lowercased() == "content-encoding" {
        expectedHeaders.removeValue(forKey: key)
    }
    // When compression middleware is actually wired below, the real compression
    // layer sets Content-Encoding/Vary on the genuine response; a fixture-declared
    // Vary here would just be a stale echo racing the real header. Drop it so the
    // assertion exercises the real value instead of a fabricated one. ~keep
    if compressionConfig != nil {
        for key in expectedHeaders.keys where key.lowercased() == "vary" {
            expectedHeaders.removeValue(forKey: key)
        }
    }

    let fullRoute = "/fixtures/\(fixtureId)\(route)"

    // Build the response envelope once. `expectedBodyJSON` is spliced in verbatim (already valid
    // JSON text) rather than passed through `JSONSerialization`, which would re-encode it and
    // lose float formatting. Only `headers` goes through `JSONSerialization`, which is safe
    // since it is a flat `[String: String]` with no numeric values.
    let expectedHeadersData = (try? JSONSerialization.data(withJSONObject: expectedHeaders, options: [])) ?? Data("{}".utf8)
    let expectedHeadersJSON = String(data: expectedHeadersData, encoding: .utf8) ?? "{}"
    let responseEnvelope = "{\"status_code\":\(expectedStatus),\"{{ response_body_field }}\":\(expectedBodyJSON),\"headers\":\(expectedHeadersJSON)}"

    // Create handler that returns the expected response.
    let handler_fn: (String) -> String = { _ in responseEnvelope }

    // Register the route with the handler using the convenience method for the HTTP verb,
    // forwarding the decoded cors/compression config so the Rust core's real middleware
    // enforces it. The core auto-generates a real OPTIONS preflight handler for any route
    // that carries a `cors` config and has no explicit OPTIONS handler of its own (see
    // `spikard-http/src/server/mod.rs`), so no harness-side preflight emulation is needed. ~keep
    do {
        switch methodStr {
        case "get":     try app.get(handler_fn, path: fullRoute, cors: corsConfig, compression: compressionConfig)
        case "post":    try app.post(handler_fn, path: fullRoute, cors: corsConfig, compression: compressionConfig)
        case "put":     try app.put(handler_fn, path: fullRoute, cors: corsConfig, compression: compressionConfig)
        case "patch":   try app.patch(handler_fn, path: fullRoute, cors: corsConfig, compression: compressionConfig)
        case "delete":  try app.delete(handler_fn, path: fullRoute, cors: corsConfig, compression: compressionConfig)
        case "head":    try app.head(handler_fn, path: fullRoute, cors: corsConfig, compression: compressionConfig)
        case "options": try app.options(handler_fn, path: fullRoute, cors: corsConfig, compression: compressionConfig)
        default: continue
        }
    } catch {
        print("Failed to register route \(fullRoute): \(error)")
        continue
    }
}

// Configure and start the server.
// SPIKARD_SERVER_PORT is set by the spawner when it allocates a free
// ephemeral port; fall back to the configured default port otherwise.
let effectivePort = ProcessInfo.processInfo.environment["SPIKARD_SERVER_PORT"].flatMap { UInt16($0) } ?? {{ port }}
try app.config(host: "{{ host }}", port: effectivePort)
print("Harness listening on {{ host }}:\(effectivePort)")
fflush(stdout)
try app.run()
