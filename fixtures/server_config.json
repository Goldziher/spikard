  {
    "id": "server_jwt_and_api_key_auth_combined",
    "description": "Tests server with both JWT and API key authentication configured",
    "category": "server_config",
    "docs": {
      "topic": "server_config",
      "stem": "server_jwt_and_api_key_auth_combined"
    },
    "http": {
      "handler": {
        "route": "/secure",
        "method": "GET",
        "parameters": {
          "headers": {
            "Authorization": {
              "type": "string"
            },
            "X-API-Key": {
              "type": "string"
            }
          }
        },
        "middleware": {
          "jwt_auth": {
            "enabled": true,
            "algorithm": "HS256",
            "secret": "test-secret"
          },
          "api_key_auth": {
            "enabled": true,
            "header_name": "X-API-Key",
            "keys": [
              "sk_test_123456",
              "sk_test_789012"
            ]
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/secure",
        "headers": {
          "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ0ZXN0IiwiZXhwIjoyNjI2NzgzOTQ2fQ.test"
        }
      },
      "expected_response": {
        "status_code": 200,
        "body": {
          "authenticated": true
        }
      }
    },
    "tags": [
      "server_config",
      "auth",
      "jwt",
      "api_key"
    ]
  },
