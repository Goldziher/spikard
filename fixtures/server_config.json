        "method": "POST",
        "body_schema": {
          "type": "object",
          "properties": {
            "data": {
              "type": "string"
            }
          },
          "required": [
            "data"
          ]
        }
      },
      "request": {
        "method": "POST",
        "path": "/upload",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "data": "x"
        }
      },
      "expected_response": {
        "status_code": 200,
        "body": {
          "received": 1
        }
      }
    },
    "tags": [
